#!/usr/bin/env bash
set -euo pipefail

# Tag and publish a release after the PR merges.
# Usage: ./bin/release <version>

VERSION="${1:?Usage: release <version> (e.g. 1.2.0)}"
REPO="jacobEAdamson/data-munger-mcp"
TAG="v$VERSION"

# ─── Sanity checks ─────────────────────────────────────────────────────

if [ -n "$(git status --porcelain)" ]; then
  echo "Working tree has uncommitted changes. Commit or stash first."
  exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" != "master" ]; then
  echo "Not on master. Currently on '$BRANCH'. Switch to master first."
  exit 1
fi

# ─── Fetch latest and verify ───────────────────────────────────────────

echo "Fetching latest from origin..."
git fetch origin master --tags

# Ensure we're up to date
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/master)
if [ "$LOCAL" != "$REMOTE" ]; then
  echo "Local master ($LOCAL) is not at origin/master ($REMOTE). Pull first."
  exit 1
fi

# Verify package.json version
PKG_VERSION=$(node -p "require('./package.json').version")
if [ "$PKG_VERSION" != "$VERSION" ]; then
  echo "package.json version ($PKG_VERSION) doesn't match requested version ($VERSION)."
  exit 1
fi

# Check no existing tag
if git rev-parse "$TAG" 2>/dev/null; then
  echo "Tag $TAG already exists locally."
  exit 1
fi

# ─── Tag and push ──────────────────────────────────────────────────────

echo "Creating tag $TAG..."
git tag "$TAG"

echo "Pushing tag $TAG..."
cd "$(dirname "$0")"  # move to bin/
./push-tag "$TAG"

echo ""
echo "Published v$VERSION."
echo "Watch: https://github.com/$REPO/actions"